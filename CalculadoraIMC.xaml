<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticaUI.CalculadoraIMC"
             Title="CalculadoraIMC">
    <!-- Scrollview esto nos permite deslizar si el teclado tapa parte de la pantalla-->
    <ScrollView>

        <!--VerticalStackLayout: apila los controles uno debajo de otro-->
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Label Text="Calculadora IMC" FontSize="30" FontAttributes="Bold" 
                   TextColor="#0ED9F0" HorizontalOptions="Center" />

            <!--Campo para ingresar el peso-->
            <Label Text="Peso (kg):" TextColor="Black" FontAttributes="Bold" />
            <!-- Border: Dibuja un marco con esquinas redondeadas alrededor del Entry -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">
                <!-- x:Name es el nombre con el que C# encuentra este control (txtPeso.Text)-->
                <!-- La propiedad Keyboard="Numeric": en pantalla muestra numeros -->
                <Entry x:Name="txtPeso" Placeholder="Ejemplo: 70.5" Keyboard="Numeric" />
            </Border>

            <!-- Campo para ingresar la altura -->
            <Label Text="Altura (metros):" TextColor="Black" FontAttributes="Bold" />
            <!-- Border: Dibuja un marco con esquinas redondeadas alrededor del Entry -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">
                <!-- x:Name es el nombre con el que C# encuentra este control (txtAltura.Text)-->
                <!-- La propiedad Keyboard="Numeric": en pantalla muestra numeros -->
                <Entry x:Name="txtAltura" Placeholder="Ejemplo: 1.75" Keyboard="Numeric" />
            </Border>

            <!--Boton: Clicked="...." indica que metodo de C# se ejecuta al tocarlo-->
            <Button Text="Calcular IMC" BackgroundColor="#0ED9F0" TextColor="White" FontAttributes="Bold" CornerRadius="8"
                    Clicked="Button_clicked" />

            <!--Tarjeta de Resultado: IsVisible="False" la oculta hasta que se calcule-->
            <Border x:Name="brResultado" Stroke="Black" StrokeShape="RoundRectangle 12" Padding="20" 
                    IsVisible="False" Margin="0,10,0,0">
                <!--Estos tres labels se van a llenar desde C#-->
                <VerticalStackLayout>
                    <Label x:Name="lblValorIMC" FontSize="32" FontAttributes="Bold" TextColor="#0ED9F0" HorizontalOptions="Center" />
                    <Label x:Name="lblDiagnostico" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                    <Label x:Name="lblRango" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>